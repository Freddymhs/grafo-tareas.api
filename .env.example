# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://grafo:grafo@localhost:5433/grafo_tareas?schema=public

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3001

# Logging
PINO_LOG_LEVEL=info

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Roles del área (FASE 8): el docs/roles.yaml del orquestador. Sin ella, GET /roles vacío y GET /etapas = la lista fija.
ROLES_ARCHIVO=

# Importador de Todoist (FASE 3): solo lectura. Va en ~/.zsh_secrets, nunca acá ni en el repo.
TODOIST_API_KEY=
