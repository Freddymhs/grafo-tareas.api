              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "summary": "Las columnas del tablero, en orden",
        "tags": ["Etapas"]
      }
    },
    "/api/v1/conexiones": {
      "get": {
        "operationId": "ConexionesController_findAll",
        "parameters": [
          {
            "name": "nodoId",
            "required": false,
            "in": "query",
            "description": "Conexiones que salen o entran a este nodo",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "tipo",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "DEPENDE_DE",
                "ESPERA_RESPUESTA_DE",
                "BLOQUEADA_POR",
                "PERTENECE_A",
                "EN_DAILY_DE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ConexionResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Listar conexiones, de un nodo o de un tipo",
        "tags": ["Conexiones"]
      },
      "post": {
        "operationId": "ConexionesController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConexionDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConexionResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Conectar dos nodos",
        "tags": ["Conexiones"]
      }
    },
    "/api/v1/conexiones/{id}": {
      "delete": {
        "operationId": "ConexionesController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
