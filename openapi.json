              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Quitar una conexión",
        "tags": ["Conexiones"]
      }
    },
    "/api/v1/ramas": {
      "get": {
        "operationId": "RamasController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RamaResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Las ramas de color y cuántos nodos tiene cada una",
