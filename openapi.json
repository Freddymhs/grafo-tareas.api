{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service healthy"
          },
          "503": {
            "description": "Service degraded"
          }
        },
        "summary": "Health check with DB connectivity",
        "tags": ["Health"]
      }
    },
    "/api/v1/nodos": {
      "get": {
        "operationId": "NodosController_findAll",
        "parameters": [
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "default": 0,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 500,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "tipo",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "TAREA",
                "HISTORIA",
                "FASE",
                "RAMA",
                "DUDA",
                "PERSONA",
                "PR",
                "DAILY_ITEM"
              ]
            }
          },
          {
            "name": "estado",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["ABIERTO", "CERRADO"]
            }
          },
          {
            "name": "etapa",
            "required": false,
            "in": "query",
            "description": "Columna del tablero; vacía (\"\") = sin etapa",
            "schema": {
              "example": "ENTENDIMIENTO",
              "type": "string"
            }
          },
          {
            "name": "etiqueta",
            "required": false,
            "in": "query",
            "schema": {
              "example": "daily",
              "type": "string"
            }
          },
          {
            "name": "rama",
            "required": false,
            "in": "query",
            "description": "Solo los nodos que PERTENECEN_A esta rama",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Busca en título y descripción, sin distinguir mayúsculas",
            "schema": {
              "example": "25327",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaNodosDto"
                }
              }
            }
          }
        },
        "summary": "Listar nodos: por tipo, estado, etapa, etiqueta, rama o texto",
        "tags": ["Nodos"]
      },
      "post": {
        "operationId": "NodosController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNodoDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodoResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Crear un nodo",
        "tags": ["Nodos"]
      }
    },
    "/api/v1/nodos/posiciones": {
      "put": {
        "operationId": "NodosController_guardarPosiciones",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuardarPosicionesDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{ guardadas: n }"
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Guardar las posiciones del mapa 3D en lote (todo o nada)",
        "tags": ["Nodos"]
      }
    },
    "/api/v1/nodos/{id}": {
      "get": {
        "operationId": "NodosController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodoResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Obtener un nodo",
        "tags": ["Nodos"]
      },
      "patch": {
        "operationId": "NodosController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNodoDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodoResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Editar un nodo (título, estado, color…)",
        "tags": ["Nodos"]
      },
      "delete": {
        "operationId": "NodosController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "summary": "Borrar un nodo y sus conexiones",
        "tags": ["Nodos"]
      }
    },
    "/api/v1/etapas": {
      "get": {
        "operationId": "EtapasController_lista",
