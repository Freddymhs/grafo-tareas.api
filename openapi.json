  "info": {
    "title": "grafo-tareas API",
    "description": "Tareas como grafo: nodos, conexiones, ramas y lo derivado (bloqueado, hoy puedo, qué se libera)",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "NodoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "TAREA",
              "HISTORIA",
              "FASE",
              "RAMA",
              "DUDA",
              "PERSONA",
              "PR",
              "DAILY_ITEM"
            ]
          },
          "titulo": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": ["ABIERTO", "CERRADO"]
          },
          "color": {
            "type": "string",
            "nullable": true
          },
          "etapa": {
            "type": "string",
            "nullable": true
          },
          "etiquetas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prioridad": {
            "type": "number",
            "nullable": true
          },
          "vence": {
            "type": "string",
            "nullable": true,
            "format": "date"
          },
          "descripcion": {
            "type": "string",
            "nullable": true
          },
          "externoOrigen": {
            "type": "string",
            "nullable": true
          },
          "externoId": {
            "type": "string",
            "nullable": true
          },
          "posX": {
            "type": "number",
            "nullable": true
          },
          "posY": {
            "type": "number",
            "nullable": true
          },
          "posZ": {
            "type": "number",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "tipo",
          "titulo",
          "estado",
          "etiquetas",
          "createdAt",
          "updatedAt"
        ]
      },
      "PaginaNodosDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NodoResponseDto"
            }
          },
          "total": {
            "type": "number",
            "description": "Total que cumple el filtro, sin paginar"
          }
        },
        "required": ["data", "total"]
      },
      "PosicionNodoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "x": {
            "type": "number",
            "example": 1.25
          },
          "y": {
            "type": "number",
            "example": 1.6
          },
          "z": {
            "type": "number",
            "example": -2.4
          }
        },
        "required": ["id", "x", "y", "z"]
      },
      "GuardarPosicionesDto": {
        "type": "object",
        "properties": {
          "posiciones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PosicionNodoDto"
            }
          }
        },
        "required": ["posiciones"]
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "nombre"
          },
          "message": {
            "type": "string",
            "example": "must not be empty"
          }
        },
        "required": ["field", "message"]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetailDto"
            }
          },
          "meta": {
            "type": "object"
          }
        },
        "required": ["statusCode", "error", "message", "meta"]
      },
      "CreateNodoDto": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "TAREA",
              "HISTORIA",
              "FASE",
              "RAMA",
              "DUDA",
              "PERSONA",
              "PR",
              "DAILY_ITEM"
            ],
            "example": "TAREA"
          },
          "titulo": {
            "type": "string",
            "example": "Revisar la colección del PBI 24972"
          },
          "descripcion": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": ["ABIERTO", "CERRADO"],
            "default": "ABIERTO"
          },
          "etapa": {
            "type": "string",
            "example": "ENTENDIMIENTO",
            "description": "Columna del tablero: una de GET /etapas. Sin etapa = entrada"
          },
          "etiquetas": {
            "example": ["daily", "propuesta"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prioridad": {
            "type": "number",
            "example": 2,
            "minimum": 1,
            "maximum": 4,
            "description": "1 = la más urgente"
          },
          "vence": {
            "type": "string",
            "example": "2026-10-20",
            "description": "Fecha YYYY-MM-DD"
          },
          "color": {
            "type": "string",
            "example": "#3b82f6",
            "description": "Solo para nodos RAMA"
          },
          "externoOrigen": {
            "type": "string",
            "example": "mi-tablero",
            "description": "Herramienta de origen (texto libre). Va junto con externoId"
          },
          "externoId": {
            "type": "string",
            "example": "6Vh..."
          }
        },
        "required": ["tipo", "titulo"]
      },
      "UpdateNodoDto": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "example": "Revisar la colección del PBI 24972"
          },
          "descripcion": {
            "type": "string"
          },
          "estado": {
            "type": "string",
            "enum": ["ABIERTO", "CERRADO"],
            "default": "ABIERTO"
          },
          "etiquetas": {
            "example": ["daily", "propuesta"],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prioridad": {
            "type": "number",
            "example": 2,
            "minimum": 1,
            "maximum": 4,
            "description": "1 = la más urgente"
          },
          "vence": {
            "type": "string",
            "example": "2026-10-20",
            "description": "Fecha YYYY-MM-DD"
          },
          "color": {
            "type": "string",
            "example": "#3b82f6",
            "description": "Solo para nodos RAMA"
          },
          "etapa": {
            "type": "string",
            "example": "ENTENDIMIENTO",
            "nullable": true,
            "description": "Columna del tablero: una de GET /etapas. null = vuelve a la entrada"
          }
        }
      },
      "ConexionResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "origenId": {
            "type": "string",
            "format": "uuid"
          },
          "destinoId": {
            "type": "string",
            "format": "uuid"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "DEPENDE_DE",
              "ESPERA_RESPUESTA_DE",
              "BLOQUEADA_POR",
              "PERTENECE_A",
              "EN_DAILY_DE"
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": ["id", "origenId", "destinoId", "tipo", "createdAt"]
      },
      "CreateConexionDto": {
        "type": "object",
        "properties": {
          "origenId": {
            "type": "string",
            "format": "uuid",
            "description": "El nodo que depende / pertenece"
          },
          "destinoId": {
            "type": "string",
            "format": "uuid",
            "description": "El nodo del que depende / al que pertenece"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "DEPENDE_DE",
              "ESPERA_RESPUESTA_DE",
              "BLOQUEADA_POR",
              "PERTENECE_A",
              "EN_DAILY_DE"
            ],
