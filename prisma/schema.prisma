generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Qué es un nodo del grafo (docs/_CONCEPTO.md § Modelo de dominio). HISTORIA y no HU: vocabulario de cualquier empresa.
enum TipoNodo {
  TAREA
  HISTORIA
  FASE
  RAMA
  DUDA
  PERSONA
  PR
  DAILY_ITEM
}

enum EstadoNodo {
  ABIERTO
  CERRADO
}

/// FASE 17: de qué cara de su HU es un nodo. REAL = lo que se trabaja; PLAN = lo que se intuyó que había que hacer (las
/// piezas del reparto). La decide el proyecto de origen al importar, y se mueve editando el nodo.
enum Cara {
  REAL
  PLAN
}

/// DEPENDE_DE, ESPERA_RESPUESTA_DE y BLOQUEADA_POR bloquean al origen mientras el destino siga ABIERTO.
enum TipoConexion {
  DEPENDE_DE
  ESPERA_RESPUESTA_DE
  BLOQUEADA_POR
  PERTENECE_A
  EN_DAILY_DE
}

model Nodo {
  id            String     @id @default(uuid())
  tipo          TipoNodo
  titulo        String
  descripcion   String?
  /// Una línea con las palabras del humano: de qué trata el nodo, para explicarlo en una reunión sin cuaderno
  /// (2026-10-26). La escribe /flow:pbi:compactar con su sí; la VR la muestra al seleccionar el nodo.
  resumen       String?
  estado        EstadoNodo @default(ABIERTO)
  cara          Cara       @default(REAL)
  /// Solo los nodos RAMA: el color de la rama, en hex (#rrggbb).
  color         String?
  /// De dónde se importó (texto libre: todoist, azure, github…) y su id allá. La API no conoce la lista (C3).
  externoOrigen String?    @map("externo_origen")
  externoId     String?    @map("externo_id")
  /// Columna del tablero (una de ETAPAS, C9); null = entrada. Tiene sentido en TAREA e HISTORIA.
  etapa         String?
  etiquetas     String[]   @default([])
  /// 1 = la más urgente … 4 = sin prioridad (los p1-p4 de Todoist).
  prioridad     Int?
  vence         DateTime?  @db.Date
  /// Posición en el mapa 3D, persistida para que el mapa no cambie entre sesiones (C2).
  posX          Float?     @map("pos_x")
  posY          Float?     @map("pos_y")
  posZ          Float?     @map("pos_z")
  /// Cuándo nació en su fuente (la fecha de creación de la tarjeta en Todoist); lo creado acá, al crearse. Nunca vacía:
  /// todo nodo tiene fecha (FASE 15) y nada se oculta por no tenerla.
  fechaOrigen   DateTime   @default(now()) @map("fecha_origen")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  salientes Conexion[] @relation("origen")
  entrantes Conexion[] @relation("destino")

  @@unique([externoOrigen, externoId])
  @@index([tipo, estado])
  @@index([etapa])
  @@map("nodos")
}

model Conexion {
  id        String       @id @default(uuid())
  origenId  String       @map("origen_id")
  destinoId String       @map("destino_id")
  tipo      TipoConexion
  createdAt DateTime     @default(now()) @map("created_at")

  origen  Nodo @relation("origen", fields: [origenId], references: [id], onDelete: Cascade)
  destino Nodo @relation("destino", fields: [destinoId], references: [id], onDelete: Cascade)

  @@unique([origenId, destinoId, tipo])
  @@index([destinoId])
  @@map("conexiones")
}

/// Lo descartado al pulir el grafo (FASE 16): el nodo entero y sus conexiones, para verlo y deshacerlo. Lo descartado
/// NO está en `nodos`, así que ninguna lectura lo ve; el importador no lo revive (mismo externo).
model Descarte {
  id            String   @id @default(uuid())
  nodoId        String   @unique @map("nodo_id")
  externoOrigen String?  @map("externo_origen")
  externoId     String?  @map("externo_id")
  titulo        String
  /// La fila del nodo tal cual estaba (con su posición): restaurar la vuelve a crear con el mismo id.
  nodo          Json
  /// Sus conexiones (las dos direcciones): al restaurar vuelven las que todavía tienen su otro extremo.
  conexiones    Json
  motivo        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([externoOrigen, externoId])
  @@map("descartes")
}

enum TipoCambio {
  EDICION
  DESCARTE
  RESTAURACION
}

/// La bitácora del pulido (FASE 16): qué cambió en el grafo respecto de su fuente, y por qué. Sin llave al nodo, a
/// propósito: sobrevive a que se descarte. Al final, el contraste Todoist ↔ grafo sale de acá.
model Cambio {
  id            String     @id @default(uuid())
  nodoId        String     @map("nodo_id")
  externoOrigen String?    @map("externo_origen")
  externoId     String?    @map("externo_id")
  titulo        String
  tipo          TipoCambio
  /// En una EDICION: el campo que cambió, y su valor antes y después (como texto).
  campo         String?
  antes         String?
  despues       String?
  motivo        String?
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([nodoId])
  @@index([externoOrigen, externoId])
  @@map("cambios")
}
